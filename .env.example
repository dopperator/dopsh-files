# Bearer token required to upload. Generate with: openssl rand -hex 32
UPLOAD_TOKEN=

# Supabase project settings (Storage tier for files <= 50 MB)
# Leave blank to disable Supabase tier; only local uploads will work.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=dopsh

# Hard per-file cap in bytes. Default 2 GB.
HARD_MAX=2147483648

# Total local-storage soft cap in bytes. Default 10 GB.
TOTAL_LOCAL_CAP=10737418240

# Public canonical base URL (no trailing slash).
PUBLIC_BASE_URL=https://dop.sh

# Port for the Bun server.
PORT=4100
